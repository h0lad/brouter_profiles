# BRouter profile: recumbent / Liegerad
#
# Fast two-wheel recumbent for road riding and touring.
#
# Priorities:
#   - smooth, firm surfaces
#   - moderate climbing
#   - few stops, turns and barriers
#   - low traffic stress
#   - signed cycle routes, without forcing bad cycle infrastructure
#   - efficient long-distance cruising
#
# Avoids:
#   - very steep climbs
#   - rough or loose surfaces
#   - stairs and awkward barriers
#   - frequent stop-and-go
#   - dismount sections
#
# Optional: cfg_loaded_touring, cfg_rainy, cfg_prefer_cycle_routes,
# cfg_avoid_noise, cfg_strict_barriers.
#
---context:global

# User settings

# Add luggage / touring load.
assign cfg_loaded_touring = false

# Wet-surface overlay.
assign cfg_rainy = false

# Prefer signed cycle routes moderately.
assign cfg_prefer_cycle_routes = true

# Avoid noisy major-road corridors, but do not create huge detours.
assign cfg_avoid_noise = true
assign cfg_noise_strength = 0.70

# Normally a recumbent should not need carrying or awkward pushing.
assign cfg_allow_dismount = false

# Strictly respect normal one-way rules.
assign cfg_strict_oneway = true

# Cycle barriers/chicanes are especially awkward for long-wheelbase recumbents.
# false = very expensive but still routeable; true = hard block.
assign cfg_strict_barriers = false

assign cfg_allow_ferries = true
assign cfg_consider_traffic = true
assign cfg_consider_crossings = true
assign cfg_consider_elevation = true
assign cfg_block_fords = true

# Navigation and stop-and-go

# Recumbents lose more momentum and are less pleasant in repeated tight turns.
assign cfg_turn_cost = 115
assign cfg_cycle_route_turn_cost = 115

# Stop/start is more costly than on an upright bike.
assign cfg_signal_cost = 120
assign cfg_stop_cost = 45
assign cfg_give_way_cost = 12

# Bike and ETA model

# BRouter's long-standing recumbent profile uses about:
# 90 kg total mass, CdA 0.23 m², Crr 0.004, 125 W.
assign cfg_mass_unloaded = 90
assign cfg_mass_loaded = 105
assign cfg_mass = if cfg_loaded_touring then cfg_mass_loaded else cfg_mass_unloaded

assign cfg_max_speed = 60
assign cfg_drag_area = 0.23
assign cfg_rolling_resistance = 0.0045
assign cfg_rider_power = 125

# Elevation

# A recumbent cannot stand on the pedals; sustained steep climbing and very
# low-speed balance are therefore more important than on an upright bike.
assign cfg_uphill_cost_unloaded = 12
assign cfg_uphill_cost_loaded = 15
assign cfg_uphill_cost = if cfg_loaded_touring then cfg_uphill_cost_loaded else cfg_uphill_cost_unloaded
assign cfg_uphill_cutoff = 1
assign cfg_uphill_max_slope = 9
assign cfg_uphill_max_cost_unloaded = 42
assign cfg_uphill_max_cost_loaded = 52
assign cfg_uphill_max_cost = if cfg_loaded_touring then cfg_uphill_max_cost_loaded else cfg_uphill_max_cost_unloaded

# Downhill is a recumbent strength, but very steep descents still add control cost.
assign cfg_downhill_cost = 1
assign cfg_downhill_cutoff = 4
assign cfg_downhill_max_slope = 14
assign cfg_downhill_max_cost = 14

assign cfg_elevation_penalty_buffer = 5
assign cfg_elevation_max_buffer = 10
assign cfg_elevation_buffer_reduce = 0.5

# Cycle routes

assign cfg_non_cycle_route_penalty = 0.065

# Road and infrastructure preference
# 1.0 is ideal. A dedicated cycleway gets a tiny structural penalty because
# BRouter cannot see width/tight-radius geometry; traffic separation can still
# easily make it the best choice.

assign cfg_factor_cycleway = 1.07
assign cfg_factor_bicycle_road = 1.00
assign cfg_factor_living = 1.08
assign cfg_factor_residential = 1.10
assign cfg_factor_service = 1.13
assign cfg_factor_unclassified = 1.42
assign cfg_factor_road = 1.45

assign cfg_factor_tertiary_protected = 1.05
assign cfg_factor_tertiary_painted = 1.18
assign cfg_factor_tertiary_shared = 1.30
assign cfg_factor_tertiary_shoulder = 1.35
assign cfg_factor_tertiary_open = 1.55

assign cfg_factor_secondary_protected = 1.08
assign cfg_factor_secondary_painted = 1.28
assign cfg_factor_secondary_shared = 1.45
assign cfg_factor_secondary_shoulder = 1.45
assign cfg_factor_secondary_open = 2.05

assign cfg_factor_primary_protected = 1.15
assign cfg_factor_primary_painted = 1.42
assign cfg_factor_primary_shared = 1.65
assign cfg_factor_primary_shoulder = 1.60
assign cfg_factor_primary_open = 2.80

assign cfg_factor_trunk_protected = 1.45
assign cfg_factor_trunk_painted = 1.90
assign cfg_factor_trunk_shared = 2.40
assign cfg_factor_trunk_shoulder = 2.30
assign cfg_factor_trunk_open = 7.00

assign cfg_factor_track_grade1 = 1.18
assign cfg_factor_track_grade2 = 1.75
assign cfg_factor_track_grade3 = 3.50
assign cfg_factor_track_grade4 = 6.00
assign cfg_factor_track_grade5 = 10000
assign cfg_factor_track_unknown = 3.50

assign cfg_factor_path_designated = 1.45
assign cfg_factor_path_allowed = 1.85
assign cfg_factor_path_other = 10000

assign cfg_factor_footway_designated = 2.20
assign cfg_factor_footway_allowed = 2.80
assign cfg_factor_footway_other = 10000

assign cfg_factor_pedestrian_designated = 1.90
assign cfg_factor_pedestrian_allowed = 2.30
assign cfg_factor_pedestrian_other = 10000

assign cfg_factor_other = 4.00

# Surface preference

assign cfg_surface_paving_stones = 0.08
assign cfg_surface_compacted = 0.25
assign cfg_surface_fine_gravel = 0.35
assign cfg_surface_sett = 0.55
assign cfg_surface_cobblestone = 0.85
assign cfg_surface_wood = 0.45
assign cfg_surface_metal = 0.50
assign cfg_surface_gravel = 1.20
assign cfg_surface_pebblestone = 1.50
assign cfg_surface_ground = 1.80
assign cfg_surface_earth = 2.00
assign cfg_surface_dirt = 2.10
assign cfg_surface_unpaved = 1.90
assign cfg_surface_grass = 2.80
assign cfg_surface_sand = 4.00
assign cfg_surface_mud = 5.00
assign cfg_surface_clay = 3.50
assign cfg_surface_rock = 5.00
assign cfg_surface_stone = 3.00

# Smoothness

assign cfg_smooth_intermediate = 0.15
assign cfg_smooth_medium = 0.35
assign cfg_smooth_poor = 0.75
assign cfg_smooth_rough = 1.10
assign cfg_smooth_bad = 1.60
assign cfg_smooth_robust = 2.20
assign cfg_smooth_very_bad = 3.50
assign cfg_smooth_high_clearance = 6.00
assign cfg_smooth_horrible = 8.00
assign cfg_smooth_offroad = 8.00
assign cfg_smooth_very_horrible = 12.00

# Wet-surface additions

assign cfg_wet_paving_stones = 0.10
assign cfg_wet_sett = 0.25
assign cfg_wet_cobblestone = 0.45
assign cfg_wet_wood = 0.55
assign cfg_wet_metal = 0.60
assign cfg_wet_compacted = 0.08
assign cfg_wet_fine_gravel = 0.10
assign cfg_wet_gravel = 0.18
assign cfg_wet_ground = 0.40
assign cfg_wet_earth = 0.45
assign cfg_wet_dirt = 0.55
assign cfg_wet_grass = 0.70
assign cfg_wet_sand = 0.30
assign cfg_wet_mud = 1.60
assign cfg_wet_clay = 1.00
assign cfg_wet_rock = 0.80
assign cfg_wet_stone = 0.65

# Motor-traffic stress

assign cfg_traffic_1 = 0.02
assign cfg_traffic_2 = 0.05
assign cfg_traffic_3 = 0.12
assign cfg_traffic_4 = 0.28
assign cfg_traffic_5 = 0.55
assign cfg_traffic_6 = 0.85
assign cfg_traffic_7 = 1.20

assign cfg_speed_40 = 0.04
assign cfg_speed_50 = 0.10
assign cfg_speed_60 = 0.20
assign cfg_speed_70 = 0.32
assign cfg_speed_80 = 0.45
assign cfg_speed_90 = 0.58
assign cfg_speed_100 = 0.75

assign cfg_lanes_3 = 0.10
assign cfg_lanes_4 = 0.22
assign cfg_lanes_5 = 0.35
assign cfg_lanes_6plus = 0.50

assign cfg_protected_stress_scale = 0.10
assign cfg_painted_stress_scale = 0.45
assign cfg_shared_stress_scale = 0.72
assign cfg_shoulder_stress_scale = 0.58

# Noise preference

assign cfg_noise_1 = 0.02
assign cfg_noise_2 = 0.05
assign cfg_noise_3 = 0.12
assign cfg_noise_4 = 0.25
assign cfg_noise_5 = 0.42
assign cfg_noise_6 = 0.62

# Crossings

# Low recumbent seating and slower restart make risky crossings relatively costly.
assign cfg_crossing_1 = 35
assign cfg_crossing_2 = 70
assign cfg_crossing_3 = 120
assign cfg_crossing_4 = 190
assign cfg_crossing_5 = 300
assign cfg_crossing_6 = 450

# Barriers

assign cfg_cycle_barrier_cost = 260
assign cfg_chicane_cost = 220
assign cfg_gate_cost = 90
assign cfg_lift_gate_cost = 90
assign cfg_bollard_cost = 12
assign cfg_door_cost = 100

# Walking and ferries

assign cfg_dismount_factor = 5.0
assign cfg_dismount_entry_cost = 900
assign cfg_ferry_factor = 5.5
assign cfg_ferry_entry_cost = 800

# Rails, tunnels and traffic calming

assign cfg_rail_penalty = 1.30
assign cfg_rail_crossing_cost = 50
assign cfg_rail_level_crossing_cost = 100

assign cfg_tunnel_lit_penalty = 0.05
assign cfg_tunnel_unlit_penalty = 0.30

assign cfg_bump_penalty = 0.20
assign cfg_hump_penalty = 0.16
assign cfg_table_penalty = 0.08
assign cfg_rumble_penalty = 0.35

# Hard limits

assign cfg_block_cost = 10000
assign cfg_node_block_cost = 1000000
assign cfg_max_factor = 9999

# Navigation

assign cfg_turn_instruction_mode = 1
assign cfg_turn_instruction_range = 35
assign cfg_turn_instruction_roundabouts = true
assign cfg_consider_turn_restrictions = true
assign cfg_process_unused_tags = false

# BRouter globals

assign validForBikes = true
assign totalMass = cfg_mass
assign maxSpeed = cfg_max_speed
assign S_C_x = cfg_drag_area
assign C_r = cfg_rolling_resistance
assign bikerPower = cfg_rider_power

assign uphillcost = if cfg_consider_elevation then cfg_uphill_cost else 0
assign uphillcutoff = cfg_uphill_cutoff
assign uphillmaxslope = cfg_uphill_max_slope
assign uphillmaxslopecost = if cfg_consider_elevation then cfg_uphill_max_cost else 0

assign downhillcost = if cfg_consider_elevation then cfg_downhill_cost else 0
assign downhillcutoff = cfg_downhill_cutoff
assign downhillmaxslope = cfg_downhill_max_slope
assign downhillmaxslopecost = if cfg_consider_elevation then cfg_downhill_max_cost else 0

assign elevationpenaltybuffer = cfg_elevation_penalty_buffer
assign elevationmaxbuffer = cfg_elevation_max_buffer
assign elevationbufferreduce = cfg_elevation_buffer_reduce

assign turnInstructionMode = cfg_turn_instruction_mode
assign turnInstructionCatchingRange = cfg_turn_instruction_range
assign turnInstructionRoundabouts = cfg_turn_instruction_roundabouts
assign considerTurnRestrictions = cfg_consider_turn_restrictions
assign processUnusedTags = cfg_process_unused_tags
assign consider_crossing = cfg_consider_crossings


---context:way

# Signed cycle routes

assign active_cycle_route = if route_bicycle_icn=yes then true else if route_bicycle_ncn=yes then true else if route_bicycle_rcn=yes then true else route_bicycle_lcn=yes
assign cycle_route_penalty = if not cfg_prefer_cycle_routes then 0 else if active_cycle_route then 0 else cfg_non_cycle_route_penalty

# Access

assign defaultaccess = if motorroad=yes then false else if access=private|no|agricultural then false else true
assign bikeaccess = if bicycle=private|no|dismount|use_sidepath then false else if bicycle= then if vehicle= then defaultaccess else not vehicle=private|no|agricultural else true
assign footaccess = if foot=private|no|use_sidepath then false else true
assign dismount = ( and not bikeaccess footaccess )
assign access_penalty = if bikeaccess then 0 else if and cfg_allow_dismount footaccess then cfg_dismount_factor else cfg_block_cost
assign nodeaccessgranted = false

# Bicycle infrastructure

assign protected_cycle = if highway=cycleway then true else if cycleway=track|opposite_track then true else if cycleway:left=track|opposite_track then true else if cycleway:right=track|opposite_track then true else cycleway:both=track
assign painted_cycle = if cycleway=lane|opposite_lane|unmarked_lane then true else if cycleway:left=lane|opposite_lane then true else if cycleway:right=lane|opposite_lane then true else cycleway:both=lane
assign shared_cycle = if cycleway=shared_lane|share_busway then true else if cycleway:left=shared_lane|share_busway then true else if cycleway:right=shared_lane|share_busway then true else cycleway:both=shared_lane|share_busway
assign shoulder_cycle = if cycleway=shoulder then true else cycleway:both=shoulder
assign motorfree = ( or motor_vehicle=no vehicle=no )

# One-way handling

assign badoneway = if not cfg_strict_oneway then false else if reversedirection=yes then if oneway:bicycle=yes then true else if oneway= then junction=roundabout|circular else oneway=yes|true|1 else oneway=-1
assign legal_contraflow = if not badoneway then true else if oneway:bicycle=no then true else if cycleway=opposite|opposite_lane|opposite_track then true else if cycleway:left=opposite|opposite_lane|opposite_track then true else cycleway:right=opposite|opposite_lane|opposite_track
assign oneway_penalty = if legal_contraflow then 0 else cfg_block_cost

# Traffic stress

assign trafficrisk = if not cfg_consider_traffic then 0 else if estimated_traffic_class=7 then cfg_traffic_7 else if estimated_traffic_class=6 then cfg_traffic_6 else if estimated_traffic_class=5 then cfg_traffic_5 else if estimated_traffic_class=4 then cfg_traffic_4 else if estimated_traffic_class=3 then cfg_traffic_3 else if estimated_traffic_class=2 then cfg_traffic_2 else if estimated_traffic_class=1 then cfg_traffic_1 else 0
assign speedrisk = if not cfg_consider_traffic then 0 else if maxspeed=100|110|120|130 then cfg_speed_100 else if maxspeed=90 then cfg_speed_90 else if maxspeed=80|rural then cfg_speed_80 else if maxspeed=70 then cfg_speed_70 else if maxspeed=60 then cfg_speed_60 else if maxspeed=50|urban then cfg_speed_50 else if maxspeed=40 then cfg_speed_40 else 0
assign lanerisk = if not cfg_consider_traffic then 0 else if lanes=6|7|8 then cfg_lanes_6plus else if lanes=5 then cfg_lanes_5 else if lanes=4 then cfg_lanes_4 else if lanes=3 then cfg_lanes_3 else 0
assign raw_motor_stress = ( max trafficrisk ( max speedrisk lanerisk ) )
assign motor_stress = if motorfree then 0 else if highway=cycleway then 0 else if protected_cycle then multiply raw_motor_stress cfg_protected_stress_scale else if painted_cycle then multiply raw_motor_stress cfg_painted_stress_scale else if shared_cycle then multiply raw_motor_stress cfg_shared_stress_scale else if shoulder_cycle then multiply raw_motor_stress cfg_shoulder_stress_scale else raw_motor_stress

# Noise preference

assign raw_noise_penalty = if not cfg_avoid_noise then 0 else if estimated_noise_class=6 then cfg_noise_6 else if estimated_noise_class=5 then cfg_noise_5 else if estimated_noise_class=4 then cfg_noise_4 else if estimated_noise_class=3 then cfg_noise_3 else if estimated_noise_class=2 then cfg_noise_2 else if estimated_noise_class=1 then cfg_noise_1 else 0
assign noise_penalty = ( multiply raw_noise_penalty cfg_noise_strength )

# Surface preference / SMOOTHNESS

# Untagged tracks infer their typical surface from tracktype, so missing data
# is not cheaper than the same track with its surface mapped.
assign surface_penalty = if surface=asphalt|paved|concrete then 0 else if surface=paving_stones then cfg_surface_paving_stones else if surface=compacted then cfg_surface_compacted else if surface=fine_gravel then cfg_surface_fine_gravel else if surface=sett then cfg_surface_sett else if surface=cobblestone then cfg_surface_cobblestone else if surface=wood then cfg_surface_wood else if surface=metal then cfg_surface_metal else if surface=gravel then cfg_surface_gravel else if surface=pebblestone then cfg_surface_pebblestone else if surface=ground then cfg_surface_ground else if surface=earth then cfg_surface_earth else if surface=dirt then cfg_surface_dirt else if surface=unpaved then cfg_surface_unpaved else if surface=grass|grass_paver then cfg_surface_grass else if surface=sand then cfg_surface_sand else if surface=mud then cfg_surface_mud else if surface=clay then cfg_surface_clay else if surface=rock then cfg_surface_rock else if surface=stone then cfg_surface_stone else if not surface= then 0 else if not highway=track then 0 else if tracktype=grade2 then cfg_surface_gravel else if tracktype=grade3 then cfg_surface_ground else if tracktype=grade4 then cfg_surface_dirt else if tracktype=grade5 then cfg_surface_grass else 0
assign smoothness_penalty = if smoothness=excellent|very_good|good then 0 else if smoothness=intermediate then cfg_smooth_intermediate else if smoothness=medium then cfg_smooth_medium else if smoothness=poor then cfg_smooth_poor else if smoothness=rough then cfg_smooth_rough else if smoothness=bad then cfg_smooth_bad else if smoothness=robust_wheels then cfg_smooth_robust else if smoothness=very_bad then cfg_smooth_very_bad else if smoothness=high_clearance then cfg_smooth_high_clearance else if smoothness=horrible then cfg_smooth_horrible else if smoothness=off_road_wheels then cfg_smooth_offroad else if smoothness=very_horrible then cfg_smooth_very_horrible else if smoothness=impassable then cfg_block_cost else 0
assign roughness_penalty = ( max surface_penalty smoothness_penalty )

# Wet-surface additions

assign wet_penalty = if not cfg_rainy then 0 else if surface=paving_stones then cfg_wet_paving_stones else if surface=sett then cfg_wet_sett else if surface=cobblestone then cfg_wet_cobblestone else if surface=wood then cfg_wet_wood else if surface=metal then cfg_wet_metal else if surface=compacted then cfg_wet_compacted else if surface=fine_gravel then cfg_wet_fine_gravel else if surface=gravel|pebblestone then cfg_wet_gravel else if surface=ground then cfg_wet_ground else if surface=earth|unpaved then cfg_wet_earth else if surface=dirt then cfg_wet_dirt else if surface=grass|grass_paver then cfg_wet_grass else if surface=sand then cfg_wet_sand else if surface=mud then cfg_wet_mud else if surface=clay then cfg_wet_clay else if surface=rock then cfg_wet_rock else if surface=stone then cfg_wet_stone else 0

# Rails, tunnels and traffic calming

assign rail_penalty = if embedded_rails=tram|rail|yes then cfg_rail_penalty else 0
assign tunnel_penalty = if tunnel=yes then if lit=yes then cfg_tunnel_lit_penalty else cfg_tunnel_unlit_penalty else 0
assign calming_penalty = if traffic_calming=bump then cfg_bump_penalty else if traffic_calming=hump then cfg_hump_penalty else if traffic_calming=table then cfg_table_penalty else if traffic_calming=rumble_strip then cfg_rumble_penalty else 0

# Road type

assign basefactor = if highway=cycleway then cfg_factor_cycleway else if bicycle_road=yes then cfg_factor_bicycle_road else if cyclestreet=yes then cfg_factor_bicycle_road else if highway=living_street then cfg_factor_living else if highway=residential then cfg_factor_residential else if highway=service then cfg_factor_service else if highway=unclassified then cfg_factor_unclassified else if highway=road then cfg_factor_road else if highway=tertiary|tertiary_link then if protected_cycle then cfg_factor_tertiary_protected else if painted_cycle then cfg_factor_tertiary_painted else if shared_cycle then cfg_factor_tertiary_shared else if shoulder_cycle then cfg_factor_tertiary_shoulder else cfg_factor_tertiary_open else if highway=secondary|secondary_link then if protected_cycle then cfg_factor_secondary_protected else if painted_cycle then cfg_factor_secondary_painted else if shared_cycle then cfg_factor_secondary_shared else if shoulder_cycle then cfg_factor_secondary_shoulder else cfg_factor_secondary_open else if highway=primary|primary_link then if protected_cycle then cfg_factor_primary_protected else if painted_cycle then cfg_factor_primary_painted else if shared_cycle then cfg_factor_primary_shared else if shoulder_cycle then cfg_factor_primary_shoulder else cfg_factor_primary_open else if highway=trunk|trunk_link then if protected_cycle then cfg_factor_trunk_protected else if painted_cycle then cfg_factor_trunk_painted else if shared_cycle then cfg_factor_trunk_shared else if shoulder_cycle then cfg_factor_trunk_shoulder else cfg_factor_trunk_open else if highway=track then if tracktype=grade1 then cfg_factor_track_grade1 else if tracktype=grade2 then cfg_factor_track_grade2 else if tracktype=grade3 then cfg_factor_track_grade3 else if tracktype=grade4 then cfg_factor_track_grade4 else if tracktype=grade5 then cfg_factor_track_grade5 else cfg_factor_track_unknown else if highway=path then if bicycle=designated then cfg_factor_path_designated else if bicycle=yes|permissive then cfg_factor_path_allowed else cfg_factor_path_other else if highway=footway then if bicycle=designated then cfg_factor_footway_designated else if bicycle=yes|permissive then cfg_factor_footway_allowed else cfg_factor_footway_other else if highway=pedestrian then if bicycle=designated then cfg_factor_pedestrian_designated else if bicycle=yes|permissive then cfg_factor_pedestrian_allowed else cfg_factor_pedestrian_other else cfg_factor_other

# Final way cost

assign access_and_oneway = ( max access_penalty oneway_penalty )
assign normal_cost = ( add basefactor ( add cycle_route_penalty ( add motor_stress ( add noise_penalty ( add roughness_penalty ( add wet_penalty ( add rail_penalty ( add tunnel_penalty ( add calming_penalty access_and_oneway ) ) ) ) ) ) ) ) )
assign costfactor =
  if and highway= not route=ferry then cfg_block_cost
  else if route=ferry then if and cfg_allow_ferries lesser access_and_oneway 9999 then cfg_ferry_factor else cfg_block_cost else if highway=motorway|motorway_link then cfg_block_cost else if highway=proposed|abandoned|construction|via_ferrata then cfg_block_cost else if highway=steps then cfg_block_cost else if highway=bridleway then cfg_block_cost else if and cfg_block_fords ford=yes|stepping_stones then cfg_block_cost else min cfg_max_factor normal_cost

assign turncost = if junction=roundabout|circular then 0 else if active_cycle_route then cfg_cycle_route_turn_cost else cfg_turn_cost
assign initialclassifier = if route=ferry then 2 else if dismount then 3 else 1
assign initialcost = if route=ferry then cfg_ferry_entry_cost else if dismount then cfg_dismount_entry_cost else 0
assign coming_from_lowprio = highway=track|cycleway|footway|path|residential|living_street|service|unclassified|road

assign priorityclassifier = if highway=motorway then 30 else if highway=motorway_link then 29 else if highway=trunk then 28 else if highway=trunk_link then 27 else if highway=primary then 26 else if highway=primary_link then 25 else if highway=secondary then 24 else if highway=secondary_link then 23 else if highway=tertiary then 22 else if highway=tertiary_link then 21 else if highway=unclassified then 20 else if highway=residential|living_street|service|cycleway then 6 else if highway=track|road|path|footway then 4 else 0


---context:node

# Access

assign defaultaccess = if access=private|no|agricultural then false else true
assign bikeaccess = if nodeaccessgranted=yes then true else if bicycle=private|no|dismount then false else if bicycle= then if vehicle= then defaultaccess else not vehicle=private|no|agricultural else true

# Crossings

assign crossingcost = if not cfg_consider_crossings then 0 else if not way:coming_from_lowprio then 0 else if estimated_crossing_class=6 then cfg_crossing_6 else if estimated_crossing_class=5 then cfg_crossing_5 else if estimated_crossing_class=4 then cfg_crossing_4 else if estimated_crossing_class=3 then cfg_crossing_3 else if estimated_crossing_class=2 then cfg_crossing_2 else if estimated_crossing_class=1 then cfg_crossing_1 else 0

# Controls and rail crossings

assign controlcost = if highway=traffic_signals then cfg_signal_cost else if highway=stop then cfg_stop_cost else if highway=give_way then cfg_give_way_cost else 0
assign railcrossingcost = if railway=level_crossing then cfg_rail_level_crossing_cost else if railway=crossing then cfg_rail_crossing_cost else 0

# Barriers

assign hard_barrier = barrier=stile|turnstile|full-height_turnstile|kissing_gate|horse_stile|motorcycle_barrier|chain|block|log|obstacle
assign strict_barrier = barrier=cycle_barrier|chicane|motorcycle_barrier
assign barriercost = if hard_barrier then cfg_node_block_cost else if and cfg_strict_barriers strict_barrier then cfg_node_block_cost else if barrier=cycle_barrier|motorcycle_barrier then cfg_cycle_barrier_cost else if barrier=chicane then cfg_chicane_cost else if barrier=gate|swing_gate|sliding_gate|hampshire_gate|bump_gate then cfg_gate_cost else if barrier=lift_gate then cfg_lift_gate_cost else if barrier=bollard then cfg_bollard_cost else if barrier=door then cfg_door_cost else 0

assign accesscost = if bikeaccess then 0 else cfg_node_block_cost

# Apply the calculated node access, crossing, stop and barrier costs.
# Ford nodes are mostly tagged ford=*; highway=ford is the older tagging.
assign fordnode = ( or ford=yes|stepping_stones highway=ford )

assign initialcost = if and cfg_block_fords fordnode then cfg_node_block_cost else ( add accesscost ( add crossingcost ( add controlcost ( add railcrossingcost barriercost ) ) ) )
