# BRouter profile: hiking
#
# Day hikes on foot. Weather modes via cfg_extreme_heat and cfg_rainy.
#
# Priorities:
#   - marked hiking routes (route=hiking, route_foot_*)
#   - natural surfaces over asphalt
#   - forest or water nearby; forest as shade in heat
#   - low noise, few towns, low traffic
#   - sac_scale hiking and mountain_hiking
#
# Avoids:
#   - demanding_mountain_hiking (alpine_hiking and above blocked)
#   - mud, wet rock and poor trail visibility (more in rain)
#   - roads without sidewalk
#   - via_ferrata (blocked); fords cost extra in dry weather and are blocked in rain

---context:global

# User settings

# Set true for very hot weather.
# This strongly reduces tolerance for climbing and steep/technical terrain,
# increases the value of forest shade and reduces scenic detours.
assign cfg_extreme_heat = false

# Set true for wet/rainy conditions.
# This adds penalties for mud, grass, wood, metal, rock, cobbles and steep
# technical paths. This switch can be combined with either heat setting.
assign cfg_rainy = false

# Prefer signed hiking/foot route networks.
assign cfg_prefer_marked_routes = true

# Prefer forest/green or riverside surroundings.
assign cfg_prefer_scenic = true

# Avoid noisy surroundings.
assign cfg_avoid_noise = true

# Overall noise sensitivity.
# 1.00 = calibrated hiking default
# 0.75 = more direct / more road-tolerant
# 1.25 = aggressively quiet
assign cfg_noise_strength = 1.00

# Avoid larger built-up areas when a pleasant alternative exists.
assign cfg_avoid_towns = true

# Use BRouter's unsafe-crossing classes.
assign cfg_consider_crossings = true

# Use elevation costs.
assign cfg_consider_elevation = true

# T3 / demanding mountain hiking remains possible, but expensive.
assign cfg_allow_t3 = true

# T4+ is outside the default target of this general hiking profile.
assign cfg_allow_t4 = false

# Steps are acceptable, but weather-dependent.
assign cfg_allow_steps = true

# Ferries are allowed.
assign cfg_allow_ferries = true

# Fords and stepping-stone crossings are allowed in dry weather, with a small
# node cost, because marked trails often cross streams. Set false to block them.
# Rain always blocks them, regardless of this setting.
assign cfg_allow_fords_dry = true


# Main preference weights

# Marked trails get a modest bonus, not an absolute override.
assign cfg_non_marked_route_penalty = 0.08

# Turns matter less than for cycling, but excessive zig-zagging is undesirable.
assign cfg_turn_cost = 50
assign cfg_marked_turn_cost = 30

# Noise weighting.
# Hot mode keeps almost the same noise aversion. Heat already reduces
# scenic/climbing willingness elsewhere; it should not make loud roads pleasant.
assign cfg_noise_scale_cool = 1.00
assign cfg_noise_scale_hot = 0.95

# Traffic weighting.
assign cfg_traffic_scale_cool = 0.22
assign cfg_traffic_scale_hot = 0.25

# Natural surface preference.
assign cfg_paved_penalty_cool = 0.38
assign cfg_paved_penalty_hot = 0.32

# Landscape preference: either forest/green OR water is sufficient.
assign cfg_scenic_scale_cool = 0.45
assign cfg_scenic_scale_hot = 0.15

# Forest doubles as a shade proxy in extreme heat.
assign cfg_shade_scale_cool = 0.15
assign cfg_shade_scale_hot = 0.30

# Urban avoidance.
assign cfg_town_scale_cool = 0.35
assign cfg_town_scale_hot = 0.18


# Crossings and barriers

assign cfg_crossing_1 = 35
assign cfg_crossing_2 = 70
assign cfg_crossing_3 = 115
assign cfg_crossing_4 = 180
assign cfg_crossing_5 = 260
assign cfg_crossing_6 = 360

assign cfg_gate_cost = 20
assign cfg_lift_gate_cost = 20
assign cfg_stile_cost = 35
assign cfg_kissing_gate_cost = 35
assign cfg_turnstile_cost = 45
assign cfg_bollard_cost = 4


# Elevation

# Equivalent flat metres per vertical metre.
assign cfg_uphill_cost_cool = 8
assign cfg_uphill_cost_hot = 23

# Tiny slopes below this threshold are treated as noise.
assign cfg_uphill_cutoff = 1

# Steepness threshold becomes stricter in heat and rain.
assign cfg_uphill_max_slope_cool_dry = 10
assign cfg_uphill_max_slope_cool_rain = 9
assign cfg_uphill_max_slope_hot_dry = 8
assign cfg_uphill_max_slope_hot_rain = 7

# Very steep uphill cost.
assign cfg_uphill_max_cost_cool_dry = 26
assign cfg_uphill_max_cost_cool_rain = 42
assign cfg_uphill_max_cost_hot_dry = 55
assign cfg_uphill_max_cost_hot_rain = 72

# Downhill: wet steep descents get a much stronger safety cost.
assign cfg_downhill_cost_dry = 2
assign cfg_downhill_cost_rain = 5
assign cfg_downhill_cutoff = 3

assign cfg_downhill_max_slope_dry = 12
assign cfg_downhill_max_slope_rain = 9

assign cfg_downhill_max_cost_cool_dry = 15
assign cfg_downhill_max_cost_hot_dry = 20
assign cfg_downhill_max_cost_cool_rain = 38
assign cfg_downhill_max_cost_hot_rain = 45

assign cfg_elevation_penalty_buffer = 5
assign cfg_elevation_max_buffer = 10
assign cfg_elevation_buffer_reduce = 0.5


# Road factors

# 1.0 is ideal.
assign cfg_factor_path = 1.00
assign cfg_factor_footway = 1.00
assign cfg_factor_track = 1.06
assign cfg_factor_pedestrian = 1.08
assign cfg_factor_bridleway = 1.18
assign cfg_factor_steps_dry = 1.25
assign cfg_factor_steps_rain = 1.90
assign cfg_factor_living = 1.15
assign cfg_factor_residential = 1.25
assign cfg_factor_service = 1.35
assign cfg_factor_unclassified_sidewalk = 1.35
assign cfg_factor_unclassified_open = 1.90
assign cfg_factor_tertiary_sidewalk = 1.45
assign cfg_factor_tertiary_open = 3.00
assign cfg_factor_secondary_sidewalk = 2.10
assign cfg_factor_secondary_open = 5.00
assign cfg_factor_primary_sidewalk = 2.30
assign cfg_factor_primary_open = 8.00
assign cfg_factor_trunk_sidewalk = 4.00
assign cfg_factor_trunk_open = 15.00
assign cfg_factor_other = 2.50


# Surface penalties

# Natural earth is the reference surface.
assign cfg_surface_compacted = 0.03
assign cfg_surface_fine_gravel = 0.05
assign cfg_surface_gravel = 0.10
assign cfg_surface_pebblestone = 0.18
assign cfg_surface_paving_stones = 0.18
assign cfg_surface_sett = 0.25
assign cfg_surface_cobblestone = 0.35
assign cfg_surface_ground = 0.00
assign cfg_surface_earth = 0.00
assign cfg_surface_dirt = 0.02
assign cfg_surface_grass = 0.08
assign cfg_surface_sand = 0.30
assign cfg_surface_mud = 0.95
assign cfg_surface_clay = 0.45
assign cfg_surface_wood = 0.15
assign cfg_surface_metal = 0.20
assign cfg_surface_rock = 0.12
assign cfg_surface_stone = 0.12


# Smoothness complements surface; the worse signal dominates.
assign cfg_smooth_intermediate = 0.03
assign cfg_smooth_medium = 0.06
assign cfg_smooth_poor = 0.10
assign cfg_smooth_bad = 0.16
assign cfg_smooth_rough = 0.22
assign cfg_smooth_robust = 0.12
assign cfg_smooth_very_bad = 0.35
assign cfg_smooth_high_clearance = 0.70
assign cfg_smooth_horrible = 1.30
assign cfg_smooth_offroad = 1.10
assign cfg_smooth_very_horrible = 2.50


# Wet-surface penalties

# These values are added only when cfg_rainy=true.
assign cfg_wet_paving_stones = 0.20
assign cfg_wet_sett = 0.40
assign cfg_wet_cobblestone = 0.60
assign cfg_wet_compacted = 0.08
assign cfg_wet_fine_gravel = 0.06
assign cfg_wet_gravel = 0.10
assign cfg_wet_ground = 0.30
assign cfg_wet_earth = 0.35
assign cfg_wet_dirt = 0.45
assign cfg_wet_grass = 0.55
assign cfg_wet_sand = 0.25
assign cfg_wet_mud = 1.80
assign cfg_wet_clay = 1.20
assign cfg_wet_wood = 0.90
assign cfg_wet_metal = 0.90
assign cfg_wet_rock = 0.70
assign cfg_wet_stone = 0.60

# Extra rain penalty for technical hiking classes.
assign cfg_wet_t1 = 0.02
assign cfg_wet_t2 = 0.40
assign cfg_wet_t3 = 1.20
assign cfg_wet_t4 = 3.00


# Technical-trail penalties

# T1
assign cfg_sac_t1 = 0.00

# T2
assign cfg_sac_t2_cool = 0.05
assign cfg_sac_t2_hot = 0.25

# T3
assign cfg_sac_t3_cool = 0.60
assign cfg_sac_t3_hot = 1.50

# T4, only used if cfg_allow_t4=true.
assign cfg_sac_t4_cool = 4.00
assign cfg_sac_t4_hot = 6.00


# Trail visibility

assign cfg_visibility_intermediate = 0.05
assign cfg_visibility_bad = 0.25
assign cfg_visibility_horrible = 0.80
assign cfg_visibility_no = 2.00

assign cfg_visibility_scale_cool = 0.80
assign cfg_visibility_scale_hot = 1.20
assign cfg_visibility_scale_rain = 1.40


# Scenic preferences

# Raw missing-green score.
assign cfg_forest_missing_1 = 0.85
assign cfg_forest_missing_2 = 0.65
assign cfg_forest_missing_3 = 0.45
assign cfg_forest_missing_4 = 0.25
assign cfg_forest_missing_5 = 0.10
assign cfg_forest_missing_6 = 0.00
assign cfg_forest_missing_unknown = 1.00

# Raw missing-water score.
assign cfg_river_missing_1 = 0.85
assign cfg_river_missing_2 = 0.65
assign cfg_river_missing_3 = 0.45
assign cfg_river_missing_4 = 0.25
assign cfg_river_missing_5 = 0.10
assign cfg_river_missing_6 = 0.00
assign cfg_river_missing_unknown = 1.00

# Raw noise score.
# Low classes stay mild; high classes rise sharply so the router does not
# remain beside major roads for kilometres merely to save a small detour.
assign cfg_noise_1 = 0.05
assign cfg_noise_2 = 0.10
assign cfg_noise_3 = 0.20
assign cfg_noise_4 = 0.60
assign cfg_noise_5 = 1.00
assign cfg_noise_6 = 1.50

# Raw town score.
assign cfg_town_1 = 0.10
assign cfg_town_2 = 0.25
assign cfg_town_3 = 0.45
assign cfg_town_4 = 0.65
assign cfg_town_5 = 0.82
assign cfg_town_6 = 1.00


# Traffic stress

# Raw traffic score.
assign cfg_traffic_1 = 0.05
assign cfg_traffic_2 = 0.12
assign cfg_traffic_3 = 0.30
assign cfg_traffic_4 = 0.55
assign cfg_traffic_5 = 0.75
assign cfg_traffic_6 = 0.90
assign cfg_traffic_7 = 1.00


# Tunnels and ferries

assign cfg_tunnel_lit_penalty = 0.15
assign cfg_tunnel_unlit_penalty = 0.80

assign cfg_ferry_factor = 5.00
assign cfg_ferry_entry_cost = 600


# Stops and rail crossings

# Signals are usually safer crossings, so this is mainly stop/wait cost.
assign cfg_signal_cost = 8
assign cfg_stop_cost = 4
assign cfg_give_way_cost = 2

assign cfg_rail_crossing_cost = 25
assign cfg_rail_level_crossing_cost = 50


# Hard limits

assign cfg_block_cost = 10000
assign cfg_node_block_cost = 1000000
assign cfg_max_factor = 10000


# Navigation

assign cfg_turn_instruction_mode = 1
assign cfg_turn_instruction_range = 20
assign cfg_turn_instruction_roundabouts = true
assign cfg_consider_turn_restrictions = true
assign cfg_process_unused_tags = false


# Derived weather values

assign cfg_noise_scale = ( multiply ( if cfg_extreme_heat then cfg_noise_scale_hot else cfg_noise_scale_cool ) cfg_noise_strength )
assign cfg_traffic_scale = if cfg_extreme_heat then cfg_traffic_scale_hot else cfg_traffic_scale_cool
assign cfg_paved_penalty = if cfg_extreme_heat then cfg_paved_penalty_hot else cfg_paved_penalty_cool
assign cfg_scenic_scale = if cfg_extreme_heat then cfg_scenic_scale_hot else cfg_scenic_scale_cool
assign cfg_shade_scale = if cfg_extreme_heat then cfg_shade_scale_hot else cfg_shade_scale_cool
assign cfg_town_scale = if cfg_extreme_heat then cfg_town_scale_hot else cfg_town_scale_cool

assign cfg_uphill_selected = if cfg_extreme_heat then cfg_uphill_cost_hot else cfg_uphill_cost_cool

assign cfg_uphill_max_slope_selected =
  if cfg_extreme_heat then
    if cfg_rainy then cfg_uphill_max_slope_hot_rain else cfg_uphill_max_slope_hot_dry
  else
    if cfg_rainy then cfg_uphill_max_slope_cool_rain else cfg_uphill_max_slope_cool_dry

assign cfg_uphill_max_cost_selected =
  if cfg_extreme_heat then
    if cfg_rainy then cfg_uphill_max_cost_hot_rain else cfg_uphill_max_cost_hot_dry
  else
    if cfg_rainy then cfg_uphill_max_cost_cool_rain else cfg_uphill_max_cost_cool_dry

assign cfg_downhill_selected = if cfg_rainy then cfg_downhill_cost_rain else cfg_downhill_cost_dry
assign cfg_downhill_max_slope_selected = if cfg_rainy then cfg_downhill_max_slope_rain else cfg_downhill_max_slope_dry

assign cfg_downhill_max_cost_selected =
  if cfg_extreme_heat then
    if cfg_rainy then cfg_downhill_max_cost_hot_rain else cfg_downhill_max_cost_hot_dry
  else
    if cfg_rainy then cfg_downhill_max_cost_cool_rain else cfg_downhill_max_cost_cool_dry

assign cfg_visibility_mode_scale = if cfg_extreme_heat then cfg_visibility_scale_hot else cfg_visibility_scale_cool
assign cfg_visibility_weather_scale = if cfg_rainy then cfg_visibility_scale_rain else 1


# BRouter globals

assign validForFoot = true

assign consider_elevation = cfg_consider_elevation
assign consider_forest = cfg_prefer_scenic
assign consider_river = cfg_prefer_scenic

assign uphillcost = if cfg_consider_elevation then cfg_uphill_selected else 0
assign uphillcutoff = cfg_uphill_cutoff
assign uphillmaxslope = cfg_uphill_max_slope_selected
assign uphillmaxslopecost = if cfg_consider_elevation then cfg_uphill_max_cost_selected else 0

assign downhillcost = if cfg_consider_elevation then cfg_downhill_selected else 0
assign downhillcutoff = cfg_downhill_cutoff
assign downhillmaxslope = cfg_downhill_max_slope_selected
assign downhillmaxslopecost = if cfg_consider_elevation then cfg_downhill_max_cost_selected else 0

assign elevationpenaltybuffer = cfg_elevation_penalty_buffer
assign elevationmaxbuffer = cfg_elevation_max_buffer
assign elevationbufferreduce = cfg_elevation_buffer_reduce

assign turnInstructionMode = cfg_turn_instruction_mode
assign turnInstructionCatchingRange = cfg_turn_instruction_range
assign turnInstructionRoundabouts = cfg_turn_instruction_roundabouts
assign considerTurnRestrictions = cfg_consider_turn_restrictions
assign processUnusedTags = cfg_process_unused_tags

assign consider_crossing = cfg_consider_crossings


---context:way

# Hiking routes

assign hiking_route =
  if route=hiking then true
  else if route_hiking_iwn=yes then true
  else if route_hiking_nwn=yes then true
  else if route_hiking_rwn=yes then true
  else if route_hiking_lwn=yes then true
  else if route_hiking_=yes then true
  else if route_foot_nwn=yes then true
  else if route_foot_rwn=yes then true
  else if route_foot_lwn=yes then true
  else route_foot_=yes

assign nodeaccessgranted = hiking_route

assign route_penalty =
  if not cfg_prefer_marked_routes then 0
  else if hiking_route then 0
  else cfg_non_marked_route_penalty


# Access

assign defaultaccess =
  if motorroad=yes then false
  else if access=private|no then false
  else true

assign footaccess =
  if foot=private|no then false
  else if foot= then defaultaccess
  else true

assign has_sidewalk =
  if sidewalk=both|right|left|yes|separate then true
  else footway=sidewalk


# Scenic preferences

assign forest_missing_raw =
  if estimated_forest_class=6 then cfg_forest_missing_6
  else if estimated_forest_class=5 then cfg_forest_missing_5
  else if estimated_forest_class=4 then cfg_forest_missing_4
  else if estimated_forest_class=3 then cfg_forest_missing_3
  else if estimated_forest_class=2 then cfg_forest_missing_2
  else if estimated_forest_class=1 then cfg_forest_missing_1
  else cfg_forest_missing_unknown

assign river_missing_raw =
  if estimated_river_class=6 then cfg_river_missing_6
  else if estimated_river_class=5 then cfg_river_missing_5
  else if estimated_river_class=4 then cfg_river_missing_4
  else if estimated_river_class=3 then cfg_river_missing_3
  else if estimated_river_class=2 then cfg_river_missing_2
  else if estimated_river_class=1 then cfg_river_missing_1
  else cfg_river_missing_unknown

# Either forest/green or water can make a route scenic.
assign scenic_missing_raw = ( min forest_missing_raw river_missing_raw )
assign scenic_penalty = if cfg_prefer_scenic then ( multiply scenic_missing_raw cfg_scenic_scale ) else 0

# Shade matters independently in extreme heat.
assign shade_penalty = if cfg_prefer_scenic then ( multiply forest_missing_raw cfg_shade_scale ) else 0

assign noise_raw =
  if estimated_noise_class=6 then cfg_noise_6
  else if estimated_noise_class=5 then cfg_noise_5
  else if estimated_noise_class=4 then cfg_noise_4
  else if estimated_noise_class=3 then cfg_noise_3
  else if estimated_noise_class=2 then cfg_noise_2
  else if estimated_noise_class=1 then cfg_noise_1
  else 0

assign noise_penalty = if cfg_avoid_noise then ( multiply noise_raw cfg_noise_scale ) else 0

assign town_raw =
  if estimated_town_class=6 then cfg_town_6
  else if estimated_town_class=5 then cfg_town_5
  else if estimated_town_class=4 then cfg_town_4
  else if estimated_town_class=3 then cfg_town_3
  else if estimated_town_class=2 then cfg_town_2
  else if estimated_town_class=1 then cfg_town_1
  else 0

assign town_penalty = if cfg_avoid_towns then ( multiply town_raw cfg_town_scale ) else 0


# Traffic stress

assign traffic_raw =
  if estimated_traffic_class=7 then cfg_traffic_7
  else if estimated_traffic_class=6 then cfg_traffic_6
  else if estimated_traffic_class=5 then cfg_traffic_5
  else if estimated_traffic_class=4 then cfg_traffic_4
  else if estimated_traffic_class=3 then cfg_traffic_3
  else if estimated_traffic_class=2 then cfg_traffic_2
  else if estimated_traffic_class=1 then cfg_traffic_1
  else 0

assign traffic_penalty = ( multiply traffic_raw cfg_traffic_scale )


# Surface

assign surface_penalty =
  if surface=asphalt|paved|concrete then cfg_paved_penalty
  else if surface=compacted then cfg_surface_compacted
  else if surface=fine_gravel then cfg_surface_fine_gravel
  else if surface=gravel then cfg_surface_gravel
  else if surface=pebblestone then cfg_surface_pebblestone
  else if surface=paving_stones then cfg_surface_paving_stones
  else if surface=sett then cfg_surface_sett
  else if surface=cobblestone then cfg_surface_cobblestone
  else if surface=ground then cfg_surface_ground
  else if surface=earth then cfg_surface_earth
  else if surface=dirt then cfg_surface_dirt
  else if surface=grass|grass_paver then cfg_surface_grass
  else if surface=sand then cfg_surface_sand
  else if surface=mud then cfg_surface_mud
  else if surface=clay then cfg_surface_clay
  else if surface=wood then cfg_surface_wood
  else if surface=metal then cfg_surface_metal
  else if surface=rock then cfg_surface_rock
  else if surface=stone then cfg_surface_stone
  else 0

assign smoothness_penalty =
  if smoothness=excellent|very_good|good then 0
  else if smoothness=intermediate then cfg_smooth_intermediate
  else if smoothness=medium then cfg_smooth_medium
  else if smoothness=poor then cfg_smooth_poor
  else if smoothness=bad then cfg_smooth_bad
  else if smoothness=rough then cfg_smooth_rough
  else if smoothness=robust_wheels then cfg_smooth_robust
  else if smoothness=very_bad then cfg_smooth_very_bad
  else if smoothness=high_clearance then cfg_smooth_high_clearance
  else if smoothness=horrible then cfg_smooth_horrible
  else if smoothness=off_road_wheels then cfg_smooth_offroad
  else if smoothness=very_horrible then cfg_smooth_very_horrible
  else if smoothness=impassable then cfg_block_cost
  else 0

assign roughness_penalty = ( max surface_penalty smoothness_penalty )

assign wet_surface_penalty =
  if not cfg_rainy then 0
  else if surface=paving_stones then cfg_wet_paving_stones
  else if surface=sett then cfg_wet_sett
  else if surface=cobblestone then cfg_wet_cobblestone
  else if surface=compacted then cfg_wet_compacted
  else if surface=fine_gravel then cfg_wet_fine_gravel
  else if surface=gravel|pebblestone then cfg_wet_gravel
  else if surface=ground then cfg_wet_ground
  else if surface=earth|unpaved then cfg_wet_earth
  else if surface=dirt then cfg_wet_dirt
  else if surface=grass|grass_paver then cfg_wet_grass
  else if surface=sand then cfg_wet_sand
  else if surface=mud then cfg_wet_mud
  else if surface=clay then cfg_wet_clay
  else if surface=wood then cfg_wet_wood
  else if surface=metal then cfg_wet_metal
  else if surface=rock then cfg_wet_rock
  else if surface=stone then cfg_wet_stone
  else 0


# Trail visibility

assign visibility_raw =
  if trail_visibility=excellent|good then 0
  else if trail_visibility=intermediate then cfg_visibility_intermediate
  else if trail_visibility=bad then cfg_visibility_bad
  else if trail_visibility=horrible then cfg_visibility_horrible
  else if trail_visibility=no then cfg_visibility_no
  else 0

assign visibility_penalty = ( multiply visibility_raw ( multiply cfg_visibility_mode_scale cfg_visibility_weather_scale ) )


# Technical trails

assign sac_penalty =
  if sac_scale= then 0
  else if sac_scale=hiking then cfg_sac_t1
  else if sac_scale=mountain_hiking then
    if cfg_extreme_heat then cfg_sac_t2_hot else cfg_sac_t2_cool
  else if sac_scale=demanding_mountain_hiking then
    if not cfg_allow_t3 then cfg_block_cost
    else if cfg_extreme_heat then cfg_sac_t3_hot
    else cfg_sac_t3_cool
  else if sac_scale=alpine_hiking then
    if not cfg_allow_t4 then cfg_block_cost
    else if cfg_extreme_heat then cfg_sac_t4_hot
    else cfg_sac_t4_cool
  else if sac_scale=demanding_alpine_hiking|difficult_alpine_hiking then cfg_block_cost
  else 0

assign wet_sac_penalty =
  if not cfg_rainy then 0
  else if sac_scale=hiking then cfg_wet_t1
  else if sac_scale=mountain_hiking then cfg_wet_t2
  else if sac_scale=demanding_mountain_hiking then cfg_wet_t3
  else if sac_scale=alpine_hiking then cfg_wet_t4
  else 0


# Tunnels

assign tunnel_penalty =
  if tunnel=yes then
    if lit=yes then cfg_tunnel_lit_penalty
    else cfg_tunnel_unlit_penalty
  else 0


# Road type

assign basefactor =
  if highway=path then cfg_factor_path
  else if highway=footway then cfg_factor_footway
  else if highway=track then cfg_factor_track
  else if highway=pedestrian then cfg_factor_pedestrian
  else if highway=bridleway then cfg_factor_bridleway
  else if highway=steps then
    if cfg_rainy then cfg_factor_steps_rain
    else cfg_factor_steps_dry
  else if highway=living_street then cfg_factor_living
  else if highway=residential then cfg_factor_residential
  else if highway=service then cfg_factor_service
  else if highway=unclassified|road then
    if has_sidewalk then cfg_factor_unclassified_sidewalk
    else cfg_factor_unclassified_open
  else if highway=tertiary|tertiary_link then
    if has_sidewalk then cfg_factor_tertiary_sidewalk
    else cfg_factor_tertiary_open
  else if highway=secondary|secondary_link then
    if has_sidewalk then cfg_factor_secondary_sidewalk
    else cfg_factor_secondary_open
  else if highway=primary|primary_link then
    if has_sidewalk then cfg_factor_primary_sidewalk
    else cfg_factor_primary_open
  else if highway=trunk|trunk_link then
    if has_sidewalk then cfg_factor_trunk_sidewalk
    else cfg_factor_trunk_open
  else cfg_factor_other


# Final cost

assign normal_cost = ( add basefactor ( add route_penalty ( add scenic_penalty ( add shade_penalty ( add noise_penalty ( add town_penalty ( add traffic_penalty ( add roughness_penalty ( add wet_surface_penalty ( add visibility_penalty ( add sac_penalty ( add wet_sac_penalty tunnel_penalty ) ) ) ) ) ) ) ) ) ) ) )

assign ford_blocked =
  if cfg_rainy then ford=yes|stepping_stones
  else if cfg_allow_fords_dry then false
  else ford=yes|stepping_stones

assign costfactor =
  if and highway= not route=ferry then cfg_block_cost
  else
  if route=ferry then
    if and cfg_allow_ferries footaccess then cfg_ferry_factor
    else cfg_block_cost
  else if highway=motorway|motorway_link then cfg_block_cost
  else if highway=via_ferrata then cfg_block_cost
  else if highway=construction|proposed|abandoned then cfg_block_cost
  else if and highway=steps not cfg_allow_steps then cfg_block_cost
  else if ford_blocked then cfg_block_cost
  else if not footaccess then cfg_block_cost
  else min cfg_max_factor normal_cost


# Turns and transitions

assign turncost =
  if junction=roundabout|circular then 0
  else if hiking_route then cfg_marked_turn_cost
  else cfg_turn_cost

assign initialclassifier = if route=ferry then 2 else 1
assign initialcost = if route=ferry then cfg_ferry_entry_cost else 0

assign coming_from_lowprio =
  highway=path|footway|track|pedestrian|bridleway|steps|living_street|residential|service|unclassified|road


# Navigation priority

assign priorityclassifier =
  if highway=trunk then 28
  else if highway=primary then 26
  else if highway=secondary then 24
  else if highway=tertiary then 22
  else if highway=unclassified then 20
  else if highway=path|footway|track|pedestrian|bridleway then 6
  else if highway=steps then 4
  else 2


---context:node

# Access

assign defaultaccess =
  if access=private|no then false
  else true

assign footaccess =
  if nodeaccessgranted=yes then true
  else if foot=private|no then false
  else if foot= then defaultaccess
  else true


# Crossing risk

assign crossingcost =
  if not cfg_consider_crossings then 0
  else if not way:coming_from_lowprio then 0
  else if estimated_crossing_class=6 then cfg_crossing_6
  else if estimated_crossing_class=5 then cfg_crossing_5
  else if estimated_crossing_class=4 then cfg_crossing_4
  else if estimated_crossing_class=3 then cfg_crossing_3
  else if estimated_crossing_class=2 then cfg_crossing_2
  else if estimated_crossing_class=1 then cfg_crossing_1
  else 0


# Stops and rail crossings

assign controlcost =
  if highway=traffic_signals then cfg_signal_cost
  else if highway=stop then cfg_stop_cost
  else if highway=give_way then cfg_give_way_cost
  else 0

assign railcrossingcost =
  if railway=level_crossing then cfg_rail_level_crossing_cost
  else if railway=crossing then cfg_rail_crossing_cost
  else 0


# Barriers and fords

assign barriercost =
  if barrier=stile|horse_stile then cfg_stile_cost
  else if barrier=turnstile|full-height_turnstile then cfg_turnstile_cost
  else if barrier=kissing_gate then cfg_kissing_gate_cost
  else if barrier=gate|swing_gate|sliding_gate|hampshire_gate|bump_gate then cfg_gate_cost
  else if barrier=lift_gate then cfg_lift_gate_cost
  else if barrier=bollard then cfg_bollard_cost
  else 0

assign fordnodecost =
  if ford=yes|stepping_stones then
    if cfg_rainy then cfg_node_block_cost
    else if cfg_allow_fords_dry then 80
    else cfg_node_block_cost
  else if highway=ford then
    if cfg_rainy then cfg_node_block_cost
    else if cfg_allow_fords_dry then 80
    else cfg_node_block_cost
  else 0


# Final cost

assign accesscost =
  if footaccess then 0
  else cfg_node_block_cost

assign initialcost = ( add accesscost ( add fordnodecost ( add crossingcost ( add controlcost ( add railcrossingcost barriercost ) ) ) ) )
