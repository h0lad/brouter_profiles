# BRouter profile: urban walking
#
# Everyday walking in towns: errands, commuting, appointments.
#
# Priorities:
#   - direct routes, no scenic bonus
#   - footways, pedestrian zones, roads with sidewalk
#   - paved surfaces
#   - few signals (cost is waiting time)
#
# Avoids:
#   - roads without sidewalk, high traffic class and maxspeed
#   - unpaved surfaces; slippery ones more with cfg_rainy
#   - steps, more with cfg_carrying_load (blocked with cfg_step_free)

---context:global

# User settings

# Extra hill/stair cost for groceries, bags, luggage or similar load.
assign cfg_carrying_load = false

# Wet-city mode: cobbles, metal, wood, stairs and rough surfaces cost more.
assign cfg_rainy = false

# Hard step-free mode. This is not a full wheelchair/accessibility profile;
# it simply blocks highway=steps.
assign cfg_step_free = false

# Account for hills.
assign cfg_consider_elevation = true

# Use BRouter crossing-risk estimates.
assign cfg_consider_crossings = true

# Ferries remain possible, though rarely relevant in daily city walking.
assign cfg_allow_ferries = true

# One normal turn costs this many equivalent metres.
assign cfg_turn_cost = 50

# Signals mainly add waiting time; they are not treated as unsafe.
assign cfg_signal_cost = 20
assign cfg_stop_cost = 3
assign cfg_give_way_cost = 1


# Elevation

# Equivalent flat metres per vertical metre.
# Everyday walking: a hill matters, but a modest shortcut may still win.
assign cfg_uphill_cost_normal = 5.5
assign cfg_uphill_cost_loaded = 8.5
assign cfg_uphill_cutoff = 1

# Steep climbs get a stronger penalty above this grade.
assign cfg_uphill_max_slope_normal = 10
assign cfg_uphill_max_slope_loaded = 8
assign cfg_uphill_max_cost_normal = 16
assign cfg_uphill_max_cost_loaded = 24

# Mild descents are fine; very steep descents get a safety penalty.
assign cfg_downhill_cost = 1
assign cfg_downhill_cutoff = 4
assign cfg_downhill_max_slope = 12
assign cfg_downhill_max_cost_normal = 9
assign cfg_downhill_max_cost_loaded = 14

assign cfg_elevation_penalty_buffer = 5
assign cfg_elevation_max_buffer = 10
assign cfg_elevation_buffer_reduce = 0.5


# Road factors

# 1.0 is ideal. Higher values are less attractive.
assign cfg_factor_footway = 1.00
assign cfg_factor_path = 1.02
assign cfg_factor_pedestrian = 1.01
assign cfg_factor_living = 1.04

assign cfg_factor_residential_sidewalk = 1.03
assign cfg_factor_residential_open = 1.15

assign cfg_factor_service_sidewalk = 1.06
assign cfg_factor_service_open = 1.22

assign cfg_factor_unclassified_sidewalk = 1.08
assign cfg_factor_unclassified_open = 1.50

assign cfg_factor_tertiary_sidewalk = 1.10
assign cfg_factor_tertiary_open = 2.60

assign cfg_factor_secondary_sidewalk = 1.16
assign cfg_factor_secondary_open = 4.00

assign cfg_factor_primary_sidewalk = 1.25
assign cfg_factor_primary_open = 6.50

assign cfg_factor_trunk_sidewalk = 1.80
assign cfg_factor_trunk_open = 10.00

assign cfg_factor_track = 1.45
assign cfg_factor_bridleway = 1.60
assign cfg_factor_other = 2.50


# Steps

# Not used when cfg_step_free is true (steps blocked).
assign cfg_steps_factor_normal = 1.20
assign cfg_steps_factor_loaded = 1.80
assign cfg_steps_factor_rain_add = 0.25

assign cfg_steps_entry_normal = 30
assign cfg_steps_entry_loaded = 95
assign cfg_steps_entry_rain_add = 20


# Surface penalties

# Penalty by OSM surface.
assign cfg_surface_asphalt = 0.00
assign cfg_surface_paved = 0.00
assign cfg_surface_concrete = 0.00
assign cfg_surface_paving_stones = 0.03
assign cfg_surface_sett = 0.14
assign cfg_surface_cobblestone = 0.25
assign cfg_surface_compacted = 0.12
assign cfg_surface_fine_gravel = 0.18
assign cfg_surface_gravel = 0.35
assign cfg_surface_pebblestone = 0.40
assign cfg_surface_ground = 0.55
assign cfg_surface_earth = 0.60
assign cfg_surface_dirt = 0.65
assign cfg_surface_grass = 0.75
assign cfg_surface_sand = 1.10
assign cfg_surface_mud = 1.80
assign cfg_surface_clay = 1.30
assign cfg_surface_wood = 0.18
assign cfg_surface_metal = 0.20
assign cfg_surface_rock = 0.70
assign cfg_surface_stone = 0.50

# Smoothness complements surface; the worse signal dominates.
assign cfg_smooth_intermediate = 0.03
assign cfg_smooth_bad = 0.20
assign cfg_smooth_very_bad = 0.55
assign cfg_smooth_horrible = 1.40
assign cfg_smooth_very_horrible = 2.50
assign cfg_smooth_impassable = 10000


# Wet-surface penalties

# Only used when cfg_rainy is true.
assign cfg_wet_paving_stones = 0.06
assign cfg_wet_sett = 0.20
assign cfg_wet_cobblestone = 0.35
assign cfg_wet_compacted = 0.05
assign cfg_wet_fine_gravel = 0.08
assign cfg_wet_gravel = 0.15
assign cfg_wet_ground = 0.25
assign cfg_wet_earth = 0.30
assign cfg_wet_dirt = 0.35
assign cfg_wet_grass = 0.45
assign cfg_wet_sand = 0.20
assign cfg_wet_mud = 0.90
assign cfg_wet_clay = 0.65
assign cfg_wet_wood = 0.45
assign cfg_wet_metal = 0.45
assign cfg_wet_rock = 0.35
assign cfg_wet_stone = 0.30


# Traffic stress

# Traffic is secondary when a proper sidewalk exists, but significant on
# roads without pedestrian infrastructure.
assign cfg_traffic_1 = 0.02
assign cfg_traffic_2 = 0.04
assign cfg_traffic_3 = 0.08
assign cfg_traffic_4 = 0.14
assign cfg_traffic_5 = 0.22
assign cfg_traffic_6 = 0.32
assign cfg_traffic_7 = 0.45

# Penalty by maxspeed. The higher of traffic and speed penalty is used.
assign cfg_speed_50 = 0.06
assign cfg_speed_60 = 0.10
assign cfg_speed_70 = 0.16
assign cfg_speed_80 = 0.22
assign cfg_speed_90 = 0.28
assign cfg_speed_100 = 0.35

# Share of the traffic penalty that remains with and without sidewalk.
assign cfg_sidewalk_traffic_scale = 0.18
assign cfg_open_traffic_scale = 1.00


# Crossings

# Cost by BRouter crossing-risk class when entering a major road from a minor one.
assign cfg_crossing_1 = 30
assign cfg_crossing_2 = 60
assign cfg_crossing_3 = 105
assign cfg_crossing_4 = 160
assign cfg_crossing_5 = 235
assign cfg_crossing_6 = 330


# Barriers

assign cfg_gate_cost = 12
assign cfg_lift_gate_cost = 12
assign cfg_stile_cost = 55
assign cfg_cycle_barrier_cost = 28
assign cfg_turnstile_cost = 60
assign cfg_bollard_cost = 2

# Carrying bags makes awkward barriers more annoying.
assign cfg_loaded_barrier_add = 15


# Rail crossings and tunnels

assign cfg_rail_crossing_cost = 20
assign cfg_rail_level_crossing_cost = 40
assign cfg_tunnel_penalty = 0.10


# Ferries

assign cfg_ferry_factor = 4.50
assign cfg_ferry_entry_cost = 400


# Hard limits

assign cfg_block_cost = 10000
assign cfg_node_block_cost = 1000000
assign cfg_max_factor = 10000


# Navigation

assign cfg_turn_instruction_mode = 1
assign cfg_turn_instruction_range = 15
assign cfg_turn_instruction_roundabouts = true
assign cfg_consider_turn_restrictions = true
assign cfg_process_unused_tags = false


# Derived load values

assign cfg_uphill_selected =
  if cfg_carrying_load then cfg_uphill_cost_loaded
  else cfg_uphill_cost_normal

assign cfg_uphill_max_slope_selected =
  if cfg_carrying_load then cfg_uphill_max_slope_loaded
  else cfg_uphill_max_slope_normal

assign cfg_uphill_max_cost_selected =
  if cfg_carrying_load then cfg_uphill_max_cost_loaded
  else cfg_uphill_max_cost_normal

assign cfg_downhill_max_cost_selected =
  if cfg_carrying_load then cfg_downhill_max_cost_loaded
  else cfg_downhill_max_cost_normal

assign cfg_steps_factor_selected =
  if cfg_carrying_load then cfg_steps_factor_loaded
  else cfg_steps_factor_normal

assign cfg_steps_entry_selected =
  if cfg_carrying_load then cfg_steps_entry_loaded
  else cfg_steps_entry_normal


# BRouter globals

assign validForFoot = true

assign uphillcost =
  if cfg_consider_elevation then cfg_uphill_selected
  else 0

assign uphillcutoff = cfg_uphill_cutoff
assign uphillmaxslope = cfg_uphill_max_slope_selected

assign uphillmaxslopecost =
  if cfg_consider_elevation then cfg_uphill_max_cost_selected
  else 0

assign downhillcost =
  if cfg_consider_elevation then cfg_downhill_cost
  else 0

assign downhillcutoff = cfg_downhill_cutoff
assign downhillmaxslope = cfg_downhill_max_slope

assign downhillmaxslopecost =
  if cfg_consider_elevation then cfg_downhill_max_cost_selected
  else 0

assign elevationpenaltybuffer = cfg_elevation_penalty_buffer
assign elevationmaxbuffer = cfg_elevation_max_buffer
assign elevationbufferreduce = cfg_elevation_buffer_reduce

assign turnInstructionMode = cfg_turn_instruction_mode
assign turnInstructionCatchingRange = cfg_turn_instruction_range
assign turnInstructionRoundabouts = cfg_turn_instruction_roundabouts
assign considerTurnRestrictions = cfg_consider_turn_restrictions
assign processUnusedTags = cfg_process_unused_tags

assign consider_crossing = cfg_consider_crossings


---context:way

# Access

assign defaultaccess =
  if motorroad=yes then false
  else if access=private|no then false
  else true

assign footaccess =
  if foot=private|no then false
  else if foot= then defaultaccess
  else true

# Sidewalk: sidewalk=both|left|right|yes or footway=sidewalk.
assign has_sidewalk =
  if sidewalk=both|right|left|yes then true
  else footway=sidewalk


# Traffic stress

assign traffic_raw =
  if estimated_traffic_class=7 then cfg_traffic_7
  else if estimated_traffic_class=6 then cfg_traffic_6
  else if estimated_traffic_class=5 then cfg_traffic_5
  else if estimated_traffic_class=4 then cfg_traffic_4
  else if estimated_traffic_class=3 then cfg_traffic_3
  else if estimated_traffic_class=2 then cfg_traffic_2
  else if estimated_traffic_class=1 then cfg_traffic_1
  else 0

assign speed_raw =
  if maxspeed=100|110|120|130 then cfg_speed_100
  else if maxspeed=90 then cfg_speed_90
  else if maxspeed=80 then cfg_speed_80
  else if maxspeed=70 then cfg_speed_70
  else if maxspeed=60 then cfg_speed_60
  else if maxspeed=50 then cfg_speed_50
  else 0

assign traffic_base = ( max traffic_raw speed_raw )

assign traffic_penalty =
  if highway=footway|path|pedestrian|steps then 0
  else if has_sidewalk then multiply traffic_base cfg_sidewalk_traffic_scale
  else multiply traffic_base cfg_open_traffic_scale


# Surface

assign surface_penalty =
  if surface=asphalt then cfg_surface_asphalt
  else if surface=paved then cfg_surface_paved
  else if surface=concrete then cfg_surface_concrete
  else if surface=paving_stones then cfg_surface_paving_stones
  else if surface=sett then cfg_surface_sett
  else if surface=cobblestone then cfg_surface_cobblestone
  else if surface=compacted then cfg_surface_compacted
  else if surface=fine_gravel then cfg_surface_fine_gravel
  else if surface=gravel then cfg_surface_gravel
  else if surface=pebblestone then cfg_surface_pebblestone
  else if surface=ground then cfg_surface_ground
  else if surface=earth then cfg_surface_earth
  else if surface=dirt then cfg_surface_dirt
  else if surface=grass|grass_paver then cfg_surface_grass
  else if surface=sand then cfg_surface_sand
  else if surface=mud then cfg_surface_mud
  else if surface=clay then cfg_surface_clay
  else if surface=wood then cfg_surface_wood
  else if surface=metal then cfg_surface_metal
  else if surface=rock then cfg_surface_rock
  else if surface=stone then cfg_surface_stone
  else 0

assign smoothness_penalty =
  if smoothness=excellent|very_good|good then 0
  else if smoothness=intermediate then cfg_smooth_intermediate
  else if smoothness=bad then cfg_smooth_bad
  else if smoothness=very_bad then cfg_smooth_very_bad
  else if smoothness=horrible then cfg_smooth_horrible
  else if smoothness=very_horrible then cfg_smooth_very_horrible
  else if smoothness=impassable then cfg_smooth_impassable
  else 0

assign roughness_penalty = ( max surface_penalty smoothness_penalty )

assign wet_surface_penalty =
  if not cfg_rainy then 0
  else if surface=paving_stones then cfg_wet_paving_stones
  else if surface=sett then cfg_wet_sett
  else if surface=cobblestone then cfg_wet_cobblestone
  else if surface=compacted then cfg_wet_compacted
  else if surface=fine_gravel then cfg_wet_fine_gravel
  else if surface=gravel|pebblestone then cfg_wet_gravel
  else if surface=ground then cfg_wet_ground
  else if surface=earth|unpaved then cfg_wet_earth
  else if surface=dirt then cfg_wet_dirt
  else if surface=grass|grass_paver then cfg_wet_grass
  else if surface=sand then cfg_wet_sand
  else if surface=mud then cfg_wet_mud
  else if surface=clay then cfg_wet_clay
  else if surface=wood then cfg_wet_wood
  else if surface=metal then cfg_wet_metal
  else if surface=rock then cfg_wet_rock
  else if surface=stone then cfg_wet_stone
  else 0


# Road type

assign basefactor =
  if highway=footway then cfg_factor_footway
  else if highway=path then cfg_factor_path
  else if highway=pedestrian then cfg_factor_pedestrian
  else if highway=living_street then cfg_factor_living

  else if highway=residential then
    if has_sidewalk then cfg_factor_residential_sidewalk
    else cfg_factor_residential_open

  else if highway=service then
    if has_sidewalk then cfg_factor_service_sidewalk
    else cfg_factor_service_open

  else if highway=unclassified|road then
    if has_sidewalk then cfg_factor_unclassified_sidewalk
    else cfg_factor_unclassified_open

  else if highway=tertiary|tertiary_link then
    if has_sidewalk then cfg_factor_tertiary_sidewalk
    else cfg_factor_tertiary_open

  else if highway=secondary|secondary_link then
    if has_sidewalk then cfg_factor_secondary_sidewalk
    else cfg_factor_secondary_open

  else if highway=primary|primary_link then
    if has_sidewalk then cfg_factor_primary_sidewalk
    else cfg_factor_primary_open

  else if highway=trunk|trunk_link then
    if has_sidewalk then cfg_factor_trunk_sidewalk
    else cfg_factor_trunk_open

  else if highway=track then cfg_factor_track
  else if highway=bridleway then cfg_factor_bridleway
  else if highway=steps then
    if cfg_step_free then cfg_block_cost
    else
      if cfg_rainy then add cfg_steps_factor_selected cfg_steps_factor_rain_add
      else cfg_steps_factor_selected

  else cfg_factor_other


# Tunnels

assign tunnel_penalty =
  if tunnel=yes then cfg_tunnel_penalty
  else 0


# Final cost

assign normal_cost = ( add basefactor ( add traffic_penalty ( add roughness_penalty ( add wet_surface_penalty tunnel_penalty ) ) ) )

assign costfactor =
  if and highway= not route=ferry then cfg_block_cost
  else
  if route=ferry then
    if and cfg_allow_ferries footaccess then cfg_ferry_factor
    else cfg_block_cost
  else if highway=motorway|motorway_link then cfg_block_cost
  else if highway=construction|proposed|abandoned then cfg_block_cost
  else if not footaccess then cfg_block_cost
  else min cfg_max_factor normal_cost


# Turns and transitions

assign turncost =
  if junction=roundabout|circular then 0
  else cfg_turn_cost

assign initialclassifier =
  if route=ferry then 2
  else if highway=steps then 3
  else 1

assign initialcost =
  if route=ferry then cfg_ferry_entry_cost
  else if highway=steps then
    if cfg_carrying_load then
      if cfg_rainy then add cfg_steps_entry_loaded cfg_steps_entry_rain_add
      else cfg_steps_entry_loaded
    else
      if cfg_rainy then add cfg_steps_entry_normal cfg_steps_entry_rain_add
      else cfg_steps_entry_normal
  else 0

assign coming_from_lowprio =
  highway=footway|path|pedestrian|living_street|residential|service|unclassified|road


# Navigation priority

assign priorityclassifier =
  if highway=trunk then 28
  else if highway=primary then 26
  else if highway=secondary then 24
  else if highway=tertiary then 22
  else if highway=unclassified then 20
  else if highway=footway|path|pedestrian then 6
  else if highway=steps then 4
  else 2


---context:node

# Access

assign defaultaccess =
  if access=private|no then false
  else true

assign footaccess =
  if foot=private|no then false
  else if foot= then defaultaccess
  else true


# Crossing risk

assign crossingcost =
  if not cfg_consider_crossings then 0
  else if not way:coming_from_lowprio then 0
  else if estimated_crossing_class=6 then cfg_crossing_6
  else if estimated_crossing_class=5 then cfg_crossing_5
  else if estimated_crossing_class=4 then cfg_crossing_4
  else if estimated_crossing_class=3 then cfg_crossing_3
  else if estimated_crossing_class=2 then cfg_crossing_2
  else if estimated_crossing_class=1 then cfg_crossing_1
  else 0


# Stops and rail crossings

assign controlcost =
  if highway=traffic_signals then cfg_signal_cost
  else if highway=stop then cfg_stop_cost
  else if highway=give_way then cfg_give_way_cost
  else 0

assign railcrossingcost =
  if railway=level_crossing then cfg_rail_level_crossing_cost
  else if railway=crossing then cfg_rail_crossing_cost
  else 0


# Barriers

assign loaded_barrier_extra =
  if cfg_carrying_load then cfg_loaded_barrier_add
  else 0

assign barriercost =
  if barrier=stile then add cfg_stile_cost loaded_barrier_extra
  else if barrier=turnstile then add cfg_turnstile_cost loaded_barrier_extra
  else if barrier=cycle_barrier then add cfg_cycle_barrier_cost loaded_barrier_extra
  else if barrier=gate then add cfg_gate_cost loaded_barrier_extra
  else if barrier=lift_gate then add cfg_lift_gate_cost loaded_barrier_extra
  else if barrier=bollard then cfg_bollard_cost
  else 0


# Final cost

assign accesscost =
  if footaccess then 0
  else cfg_node_block_cost

assign initialcost = ( add accesscost ( add crossingcost ( add controlcost ( add railcrossingcost barriercost ) ) ) )
